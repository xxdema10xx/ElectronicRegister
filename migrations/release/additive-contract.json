  "tables": {
    "identity_account_state": "CREATE TABLE `identity_account_state` (\r\n  `user_id` char(36) CHARACTER SET ascii NOT NULL,\r\n  `generation` bigint(20) NOT NULL DEFAULT '0',\r\n  `display_name` varchar(160) COLLATE utf8mb4_unicode_ci DEFAULT NULL,\r\n  PRIMARY KEY (`user_id`),\r\n  CONSTRAINT `fk_identity_state_user` FOREIGN KEY (`user_id`) REFERENCES `user` (`id`)\r\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci",
    "identity_account_event": "CREATE TABLE `identity_account_event` (\r\n  `id` char(36) CHARACTER SET ascii NOT NULL,\r\n  `user_id` char(36) CHARACTER SET ascii NOT NULL,\r\n  `action` varchar(40) CHARACTER SET ascii NOT NULL,\r\n  `created_at` datetime(6) NOT NULL DEFAULT CURRENT_TIMESTAMP(6),\r\n  PRIMARY KEY (`id`),\r\n  KEY `idx_identity_event_user` (`user_id`,`created_at`),\r\n  CONSTRAINT `fk_identity_event_user` FOREIGN KEY (`user_id`) REFERENCES `user` (`id`)\r\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci",
    "institution_profile_acquisition": "CREATE TABLE `institution_profile_acquisition` (\r\n  `institution_id` char(36) CHARACTER SET ascii NOT NULL,\r\n  `id` char(36) CHARACTER SET ascii NOT NULL,\r\n  `actor_user_id` char(36) CHARACTER SET ascii NOT NULL,\r\n  `actor_membership_id` char(36) CHARACTER SET ascii NOT NULL,\r\n  `target_user_id` char(36) CHARACTER SET ascii NOT NULL,\r\n  `target_membership_id` char(36) CHARACTER SET ascii NOT NULL,\r\n  `student_id` char(36) CHARACTER SET ascii DEFAULT NULL,\r\n  `teacher_id` char(36) CHARACTER SET ascii DEFAULT NULL,\r\n  `status` varchar(20) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\r\n  `request_hash` char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\r\n  `reason` varchar(1000) COLLATE utf8mb4_unicode_ci NOT NULL,\r\n  `created_at` datetime(6) NOT NULL DEFAULT CURRENT_TIMESTAMP(6),\r\n  PRIMARY KEY (`institution_id`,`id`),\r\n  KEY `fk_profile_acquisition_actor` (`institution_id`,`actor_membership_id`,`actor_user_id`),\r\n  KEY `fk_profile_acquisition_target` (`institution_id`,`target_membership_id`,`target_user_id`),\r\n  KEY `fk_profile_acquisition_student` (`institution_id`,`student_id`),\r\n  KEY `fk_profile_acquisition_teacher` (`institution_id`,`teacher_id`),\r\n  CONSTRAINT `fk_profile_acquisition_actor` FOREIGN KEY (`institution_id`, `actor_membership_id`, `actor_user_id`) REFERENCES `institution_membership` (`institution_id`, `id`, `user_id`),\r\n  CONSTRAINT `fk_profile_acquisition_student` FOREIGN KEY (`institution_id`, `student_id`) REFERENCES `student` (`institution_id`, `id`),\r\n  CONSTRAINT `fk_profile_acquisition_target` FOREIGN KEY (`institution_id`, `target_membership_id`, `target_user_id`) REFERENCES `institution_membership` (`institution_id`, `id`, `user_id`),\r\n  CONSTRAINT `fk_profile_acquisition_teacher` FOREIGN KEY (`institution_id`, `teacher_id`) REFERENCES `teacher` (`institution_id`, `id`)\r\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci",
    "identity_password_attempt": "CREATE TABLE `identity_password_attempt` (\r\n  `user_id` char(36) CHARACTER SET ascii NOT NULL,\r\n  `window_start` datetime(6) NOT NULL,\r\n  `attempts` int(11) NOT NULL,\r\n  `lease_id` char(36) CHARACTER SET ascii DEFAULT NULL,\r\n  `lease_until` datetime(6) DEFAULT NULL,\r\n  PRIMARY KEY (`user_id`),\r\n  CONSTRAINT `fk_password_attempt_user` FOREIGN KEY (`user_id`) REFERENCES `user` (`id`)\r\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci",
    "er_schema_release": "CREATE TABLE `er_schema_release` (\r\n  `version` varchar(64) CHARACTER SET ascii NOT NULL,\r\n  `applied_at` datetime(6) NOT NULL DEFAULT CURRENT_TIMESTAMP(6),\r\n  PRIMARY KEY (`version`)\r\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci"
  },
