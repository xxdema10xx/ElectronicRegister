<Project Sdk="Microsoft.NET.Sdk">
  <!-- Owner-only provisioning tool. Never part of the API image (infra/Dockerfile copies Backend/src only)
       and never references production assemblies: BCrypt and SQL are used directly. -->
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable></PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MySqlConnector" Version="2.6.1" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
  </ItemGroup>
</Project>
