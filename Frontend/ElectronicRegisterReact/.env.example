# URL del backend ElectronicRegisterAPI, comprensivo di /api (app native e build di produzione).
# Obbligatorio in produzione: senza, l'app mostra un errore all'avvio.
EXPO_PUBLIC_API_BASE=https://your-backend-host/api

# Solo web in sviluppo: Metro inoltra /api a questo backend (vedi metro.config.js), così il browser
# non viene bloccato dal CORS. Lasciare vuoto per chiamare direttamente EXPO_PUBLIC_API_BASE.
EXPO_PUBLIC_DEV_PROXY=https://your-backend-host

# Login Microsoft: valori della registrazione app su Azure (Entra ID)
EXPO_PUBLIC_MS_CLIENT_ID=your-application-client-id
EXPO_PUBLIC_MS_TENANT_ID=your-directory-tenant-id
