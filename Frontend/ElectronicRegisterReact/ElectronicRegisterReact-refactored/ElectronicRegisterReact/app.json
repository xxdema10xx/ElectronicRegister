{
  "expo": {
    "name": "ElectronicRegister",
    "slug": "ElectronicRegister",
    "scheme": "electronicregister",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/images/logoits.png",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "package": "com.xxdema10xx.ElectronicRegister",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logoits.png",
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": [
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "839dc11e-bc76-4806-b674-52d2ace47143"
      }
    }
  }
}
