.DS_Store
*.zip

# ASP.NET configuration / secrets
**/appsettings.json
**/appsettings.Development.json
**/appsettings.Local.json
**/appsettings.*.local.json

# Keep example configuration files tracked
!**/appsettings.example.json

# Environment / local files
*.env
report.json
config.js

# Build
bin/
obj/

# Dependencies
node_modules/

# Database / backup files
*.sql
*.old

# MT-5B-R1 review candidates only; keep dumps and private SQL excluded.
!/migrations/mt5/candidate-r1/000_preflight.sql
!/migrations/mt5/candidate-r1/001_security_state_expand.sql
!/migrations/mt5/candidate-r1/002_security_state_backfill.sql
!/migrations/mt5/candidate-r1/003_security_state_validate.sql
!/migrations/mt5/candidate-r1/004_membership_delete_error_contract.sql
!/migrations/mt5/candidate-r1/005_delete_contract_validate.sql

# MT-5B candidate R2: separate review revision after R3 preflight rejection.
!/migrations/mt5/candidate-r2/000_preflight.sql
!/migrations/mt5/candidate-r2/001_security_state_expand.sql
!/migrations/mt5/candidate-r2/002_security_state_backfill.sql
!/migrations/mt5/candidate-r2/003_security_state_validate.sql
!/migrations/mt5/candidate-r2/004_membership_delete_error_contract.sql
!/migrations/mt5/candidate-r2/005_delete_contract_validate.sql

# MT-5B candidate R3: reject prefix owner indexes, review package only.
!/migrations/mt5/candidate-r3/000_preflight.sql
!/migrations/mt5/candidate-r3/001_security_state_expand.sql
!/migrations/mt5/candidate-r3/002_security_state_backfill.sql
!/migrations/mt5/candidate-r3/003_security_state_validate.sql
!/migrations/mt5/candidate-r3/004_membership_delete_error_contract.sql
!/migrations/mt5/candidate-r3/005_delete_contract_validate.sql

# Visual Studio
# MT-5B-D: additive canonical IAM SQL only, never private dumps.
!/migrations/mt5/iam-d/001_membership_event.sql
!/migrations/mt5/iam-d/002_validate.sql
!/migrations/mt5/iam-d/003_event_snapshot_shape.sql
!/migrations/mt5/iam-d/004_validate_snapshot.sql
.vs/
